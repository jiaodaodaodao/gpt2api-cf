# Cloudflare 账号信息（本地部署时使用；不要提交真实值）
# 获取方式：Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token -> Edit Cloudflare Workers
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Worker 转发到的真实源站，必须先用 Docker Compose / K8s / VPS 跑起来，并能被 Cloudflare 访问。
CF_USER_WEB_ORIGIN=https://user.example.com
CF_ADMIN_WEB_ORIGIN=https://admin.example.com
CF_USER_API_ORIGIN=https://user.example.com
CF_ADMIN_API_ORIGIN=https://admin.example.com
CF_OPENAI_API_ORIGIN=https://api.example.com

# 可选：管理后台独立域名；如果不用独立域名，可以留空，仍可通过 /admin/* 转到后台前端。
CF_ADMIN_HOST=admin.example.com

# 生产建议改成你的前台/后台域名，例如：https://app.example.com,https://admin.example.com
CF_CORS_ALLOW_ORIGINS=*
